# Copy to .env and adjust. Never commit .env. Every value below is also the default.
# Base URL of every request as the browser sees it, baked in at build time. /api goes through this
# origin and is forwarded to BACKEND_URL: by the Vite dev proxy (npm run dev), or server.mjs (npm start).
VITE_API_URL=/api
# The gateway (GATEWAY_PORT in backend/.env).
BACKEND_URL=http://localhost:3000
# Garage's web endpoint for the pictures bucket. The browser loads /pictures/* from this origin (the
# backend's S3_PUBLIC_URL), and the Vite dev proxy or server.mjs forwards it here.
PICTURES_URL=http://profile-pictures.web.garage.localhost:3902
