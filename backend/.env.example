
# Every secret below is a PLACEHOLDER: `make generate_env` (run by `make dev`) copies this file to
# .env, replaces INTERNAL_KEY, DOCS_PASSWORD, POSTGRES_PASSWORD, GARAGE_RPC_SECRET, S3_ACCESS_KEY,
# S3_SECRET_KEY and both JWT secrets with random values, and asks in the terminal for the SMTP and
# GitHub OAuth credentials. Copying it by hand instead leaves INTERNAL_KEY and the JWT secrets too
# short, and the services refuse to start.

# Specify the environment (development, production, etc.)
# Most of security-related settings depend on the environment.
NODE_ENV=development
SECURE=false # In production, set this to true to enforce HTTPS and other security measures

FRONTEND_URL=http://localhost
FRONTEND_PORT=4000

# Internal key for inter-service communication (should be kept secret and secure)
# Just gateway can use this to access microserivces
INTERNAL_KEY=some_random_key

# HTTP Basic credentials for the Swagger docs (/docs, /docs-json, /<service>/docs*).
# If either is left empty the gateway does NOT serve the docs at all (fail closed), so a
# deployment can never leak the whole API surface by accident. Use strong values in production.
DOCS_USER=admin
DOCS_PASSWORD=admin

# Services
GATEWAY_PORT=3000
GATEWAY_HOST=http://localhost

# Gateway rate limiting (docs/backend/rate-limiting.md). Exactly "true" or "false"; defaults to true.
# Set to false locally if testing from one machine trips the limits (every tester is 127.0.0.1).
RATE_LIMIT_ENABLED=true

AUTH_HOST=http://localhost
AUTH_PORT=3001

NOTIFICATION_HOST=http://localhost
NOTIFICATION_PORT=3002
NOTIFICATION_MAX_PENDING_PER_USER=50

PROFILE_HOST=http://localhost
PROFILE_PORT=3003

# Set the timezone for the application (e.g., for logging and scheduling)
# it's used also in the database connection to ensure that timestamps are stored in the correct timezone.
TZ=Europe/Rome

# Database - PostgreSQL
POSTGRES_USER=pg-admin
POSTGRES_PASSWORD=pg-password
POSTGRES_DB=matcha
POSTGRES_PORT=5432

# PostgreSQL Connection String
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Object storage (Garage, S3-compatible) for profile pictures (see docs/object-storage.md)
# Generated by `make generate_env`. By hand: GARAGE_RPC_SECRET and S3_SECRET_KEY -> openssl rand -hex 32
#                                            S3_ACCESS_KEY -> echo "GK$(openssl rand -hex 12)"   (Garage requires the GK prefix)
GARAGE_RPC_SECRET=change_me_64_hex_chars
S3_ENDPOINT=http://localhost:3900 # Overridden to http://garage:3900 inside docker compose
S3_REGION=garage
S3_ACCESS_KEY=GK000000000000000000000000
S3_SECRET_KEY=change_me_64_hex_chars
S3_BUCKET=profile-pictures # The name of the bucket where profile pictures will be stored
S3_PUBLIC_URL=http://profile-pictures.web.garage.localhost:3902 # Base URL the browser uses to load images

# Silence the AWS SDK v3 "NodeVersionSupportWarning" printed on every Garage/S3 call under node <22.
AWS_SDK_JS_NODE_VERSION_SUPPORT_WARNING_DISABLED=true

# JWT Configuration
JWT_ACCESS_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRATION_MS=900000 # 15 minutes in milliseconds
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days in milliseconds

# SMTP Configuration for sending emails (e.g., for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# EMAIL Verification
EMAIL_VERIFICATION_TOKEN_LENGTH=8
EMAIL_VERIFICATION_EXPIRATION_MS=900000 # 15 minutes in milliseconds
EMAIL_VERIFICATION_MAX_ATTEMPTS=3

# Forgot Password
FORGOT_PASSWORD_TOKEN_LENGTH=12
FORGOT_PASSWORD_EXPIRATION_MS=900000 # 15 minutes in milliseconds
FORGOT_PASSWORD_MAX_ATTEMPTS=3

# Github OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=backend/node_modules
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
